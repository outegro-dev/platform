{
  "name": "outegro-dev-showcase",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "pnpm --filter @outegro/landing-web start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui",
    "infra:up": "docker compose -f infra/local/compose.yaml up -d --wait",
    "infra:down": "docker compose -f infra/local/compose.yaml down",
    "infra:reset": "docker compose -f infra/local/compose.yaml down -v",
    "env:local": "node tools/dev/generate-env.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "sharp": "0.35.4",
    "turbo": "2.11.5",
    "typescript": "6.0.3"
  }
}
