{
  "name": "@outegro/nest-common",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@outegro/contracts": "workspace:*",
    "@standard-schema/spec": "1.1.0",
    "@outegro/db": "workspace:*",
    "amqp-connection-manager": "5.0.0",
    "amqplib": "2.2.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "nestjs-pino": "5.2.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/common": "12.1.1",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.1",
    "@nestjs/platform-express": "12.1.1",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/testing": "12.1.1",
    "@nestjs/throttler": "6.7.1",
    "@swc/core": "1.16.2",
    "@testcontainers/rabbitmq": "12.2.0",
    "@testcontainers/valkey": "12.2.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.0",
    "pino-pretty": "13.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "supertest": "^7.1.0",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.2"
  }
}
