{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "@outegro/ui/lib/*": ["./src/lib/*"],
      "@outegro/ui/*": ["./src/components/*"]
    }
  },
  "include": ["src"]
}
