# atelier-browser runs on the Windows host in development:
#   pnpm --filter @outegro/atelier-browser exec playwright install chromium   (once)
#   pnpm --filter @outegro/atelier-browser dev
# Copy to .env; in Kubernetes the variables come from the pod spec.
NODE_ENV=development
PORT=4011
# Prometheus /metrics on its own port (0 turns it off); one per service locally.
METRICS_PORT=9471
LOG_LEVEL=debug
SAFE_MODE=false
# Bearer token of atelier-backend (its ATELIER_BROWSER_TOKEN), at least 32
# characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ATELIER_BROWSER_TOKEN=
# Browser contexts at once (one per request); the next requests queue.
BROWSER_CONCURRENCY=1
# One request from the first navigation to the answer (120 s).
APPLY_TIMEOUT_MS=120000
# How long a request waits for a free context before a 503 (retryable).
APPLY_QUEUE_TIMEOUT_MS=240000
# false opens a visible Chromium window, for local debugging only.
BROWSER_HEADLESS=true
