# Local development against `pnpm infra:up`. Generate .env from the repo root with `pnpm env:local`.
NODE_ENV=development
PORT=4005
# Prometheus /metrics on its own port (0 turns it off); one per service locally.
METRICS_PORT=9465
LOG_LEVEL=debug
DATABASE_URL=postgres://edu:edu@localhost:5432/edu
# Connections in the pool of this process (1-50).
DATABASE_POOL_MAX=10
VALKEY_URL=redis://localhost:6379
RABBITMQ_URL=amqp://outegro:outegro@localhost:5672
AUTH_JWKS_URL=http://localhost:4001/.well-known/jwks.json
AUTH_ISSUER=http://localhost:4001
AUTH_AUDIENCE=outegro
# Requests per minute per client address on the HTTP API (counted in Valkey).
HTTP_RATE_LIMIT_PER_MINUTE=240
# After a restore from backup (OPS-07): no event consumers, no outbox relay and
# no assistant (no calls to the model provider) until restarted without it.
SAFE_MODE=false
# The reading assistant ("explain it differently", "explain it in your own
# words", SQL hints; ADR-010). Off by default: every answer is a paid call to
# MiniMax. It also needs MINIMAX_API_KEY and stays off in SAFE_MODE.
ASSIST_ENABLED=false
# MiniMax API key. Empty: the assistant is off (GET /v1/me/assist says enabled: false).
MINIMAX_API_KEY=
# MiniMax's Anthropic-compatible Messages API (POST <base>/v1/messages).
ASSIST_BASE_URL=https://api.minimax.io/anthropic
ASSIST_MODEL=MiniMax-M3
# Answers from the model per reader per UTC day; cached answers do not count.
ASSIST_DAILY_LIMIT=30
# Requests to the model per UTC day across all readers, a cap on the provider
# bill (0: no cap). Counted: answers in full or in part, answers in progress,
# and calls the provider billed tokens for; a call it refused outright is not.
# Once reached, the assistant pauses until the next UTC day (503, "paused");
# cached answers are still served.
ASSIST_GLOBAL_DAILY_LIMIT=500
# Length limit of one answer, in model tokens.
ASSIST_MAX_TOKENS=1800
# One call to the model, the whole streamed answer included.
ASSIST_TIMEOUT_MS=90000
# Calls to the model at once per pod; the next request waits up to 20 s for a slot, then 503.
ASSIST_CONCURRENCY=3
