APP_URL=http://localhost:3005
BATTLESHIP_API_URL=http://localhost:4004
# Public origin of the game WebSocket (the browser connects to <origin>/ws).
# Production: wss://battleship.outegro.dev (ingress routes /ws to the backend).
GAME_WS_URL=ws://localhost:4004
AUTH_API_URL=http://localhost:4001
ID_URL=http://localhost:3002
SITE_URL=http://localhost:3000
# Public payments and admin frontends for the account menu and shop links.
# Production defaults: https://pay.outegro.dev, https://admin.outegro.dev
PAY_URL=http://localhost:3003
ADMIN_URL=http://localhost:3004
# Empty: the shop shows the products as "coming soon".
PAYMENTS_API_URL=
# Comma-separated https origins a checkout may redirect to.
CHECKOUT_ORIGINS=
# x-forwarded-for behind Traefik only; cf-connecting-ip behind the Cloudflare proxy
CLIENT_IP_SOURCE=x-forwarded-for
