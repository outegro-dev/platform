# Local development against `pnpm infra:up`. Generate .env from the repo root with `pnpm env:local`.
NODE_ENV=development
PORT=4100
# Prometheus /metrics on its own port (0 turns it off); one per service locally.
METRICS_PORT=9468
LOG_LEVEL=debug
DATABASE_URL=postgres://fair_roll:fair_roll@localhost:5432/fair_roll
# Shared service token: only roulette-backend calls this service.
INTERNAL_API_TOKEN=
# The secret root of the seed chain, 64 hex characters (production: Sealed Secret).
FAIR_ROLL_ROOT=
FAIR_ROLL_CHAIN_LENGTH=1000000
# Published with the commit: the value of an announced future drand round.
FAIR_ROLL_PUBLIC_SEED=local-dev
