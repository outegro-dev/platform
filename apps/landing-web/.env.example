# The site as an SSO client of id-web ("landing-web" in auth-backend's
# OAUTH_CLIENTS): the account menu in the header and silent sign-in for
# visitors already signed in at id.
# The three URLs go together. All three: sign-in is on. None: SSO is off,
# the header shows no account control, /api/account and the sign-in routes
# answer 404. Only some of them: the health probe fails. In development a blank
# one falls back to the local stack below; production has no defaults.
APP_URL=http://localhost:3000
AUTH_API_URL=http://localhost:4001
ID_URL=http://localhost:3002
# Where the visitor's IP comes from: x-forwarded-for behind Traefik only,
# cf-connecting-ip behind the Cloudflare proxy.
CLIENT_IP_SOURCE=x-forwarded-for
# Google Tag Manager container for reader statistics (GTM-XXXXXXX), read at
# runtime. Blank: no analytics, no consent note, no Google hosts in the CSP.
GTM_ID=
