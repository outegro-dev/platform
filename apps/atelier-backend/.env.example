# Local development against `pnpm infra:up` and infra/local/atelier.compose.yaml.
NODE_ENV=development
PORT=4008
# Prometheus /metrics on its own port (0 turns it off); one per service locally.
METRICS_PORT=9478
LOG_LEVEL=debug
# api: HTTP API, orchestrator, scheduler, CV links; worker: the task queues.
# Production runs both in one process: ROLE=api,worker
ROLE=api,worker
DATABASE_URL=postgres://atelier:atelier@localhost:5432/atelier
DATABASE_POOL_MAX=10
VALKEY_URL=redis://localhost:6379
RABBITMQ_URL=amqp://outegro:outegro@localhost:5672
AUTH_JWKS_URL=http://localhost:4001/.well-known/jwks.json
AUTH_ISSUER=http://localhost:4001
AUTH_AUDIENCE=outegro
# Development only: verify tokens of `node dist/tools/dev-token.js` instead
# of Identity (path it prints, e.g. ~/.atelier-dev-auth/jwks.json).
DEV_AUTH_JWKS_FILE=
HTTP_RATE_LIMIT_PER_MINUTE=240
SAFE_MODE=false

# Public CV links (https://cv.outegro.dev in production).
CV_PUBLIC_BASE_URL=http://localhost:4008/cv
# Signs the owner's device cookie (their own opens are not counted); 32+ chars.
CV_OWNER_COOKIE_SECRET=
CV_OWNER_COOKIE_DOMAIN=

# Files: pg (table `files`, the default without S3_ENDPOINT) or s3.
# Locally MinIO from infra/local/atelier.compose.yaml:
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=atelier
S3_ACCESS_KEY_ID=atelier
S3_SECRET_ACCESS_KEY=atelier-local-secret
S3_REGION=auto
S3_FORCE_PATH_STYLE=true

# Workers' services; tokens come from those apps' .env files.
LLM_GATEWAY_URL=http://localhost:4009
LLM_GATEWAY_TOKEN=
# Model profile per step: LLM_PROFILE_<STEP> (ATS_CHECK for ats-check).
LLM_PROFILE_DEFAULT=codex-sol-low
# LLM_PROFILE_REVIEW=claude-haiku-medium
LLM_TIMEOUT_MS=600000
ATELIER_TEX_URL=http://localhost:4010
ATELIER_TEX_TOKEN=
ATELIER_BROWSER_URL=http://localhost:4011
ATELIER_BROWSER_TOKEN=

# Worker: task types to consume (empty: all) and messages at once per queue.
WORKER_TASKS=
WORKER_CONCURRENCY=4
# Attempts per step before the job fails (quota pauses are not counted).
STEP_MAX_ATTEMPTS=4
LLM_QUOTA_PAUSE_SECONDS=3600
SCHEDULER_INTERVAL_MS=30000
TICK_DAILY_HOUR=6
