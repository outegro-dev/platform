# Local development against `pnpm infra:up`. Generate .env from the repo root with `pnpm env:local`.
NODE_ENV=development
PORT=4101
# Prometheus /metrics on its own port (0 turns it off); one per service locally.
METRICS_PORT=9469
LOG_LEVEL=debug
DATABASE_URL=postgres://daily:daily@localhost:5432/daily
AUTH_JWKS_URL=http://localhost:4001/.well-known/jwks.json
AUTH_ISSUER=http://localhost:4001
AUTH_AUDIENCE=outegro
# Identity's internal API: verified email, account age, current access.
AUTH_INTERNAL_URL=http://localhost:4001
INTERNAL_API_TOKEN=
# Hashes client addresses and device ids before they are stored.
DAILY_HASH_PEPPER=
# Prizes are grumbles (GRM) credited by wallet-backend (:4007, source "daily-bonus").
# "memory" is a stand-in for runs without wallet-backend; production requires http.
WALLET_MODE=memory
WALLET_URL=http://localhost:4007
WALLET_MEMORY_OPENING_BALANCE=0
