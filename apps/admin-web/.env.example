# Server-only settings of the operator console (admin.outegro.dev).
# Internal base URLs of the platform services, called server to server.
AUTH_API_URL=http://localhost:4001
NOTIFICATIONS_API_URL=http://localhost:4002
# Optional: an empty value keeps the section in its "not connected yet" state.
BATTLESHIP_API_URL=http://localhost:4004
PAYMENTS_ADMIN_API_URL=http://localhost:4003
# Public origins: the identity frontend (sign-in) and this console.
ID_URL=http://localhost:3002
APP_URL=http://localhost:3004
# x-forwarded-for behind Traefik only; cf-connecting-ip behind the Cloudflare proxy
CLIENT_IP_SOURCE=x-forwarded-for
