# Local development against `pnpm infra:up`. Generate .env from the repo root with `pnpm env:local`.
NODE_ENV=development
PORT=4003
LOG_LEVEL=debug
DATABASE_URL=postgres://payments:payments@localhost:5432/payments
VALKEY_URL=redis://localhost:6379
RABBITMQ_URL=amqp://outegro:outegro@localhost:5672
AUTH_JWKS_URL=http://localhost:4001/.well-known/jwks.json
AUTH_ISSUER=http://localhost:4001
AUTH_AUDIENCE=outegro
# pay-web: buyers return here from the Lava page; other return origins are opt-in.
PAY_WEB_URL=http://localhost:3003
CHECKOUT_RETURN_ORIGINS=
# Sales stay closed until the owner opens them; checkout also needs LAVA_API_KEY.
CHECKOUT_ENABLED=false
LAVA_API_URL=https://gate.lava.top
# Outgoing API key from the lava.top cabinet. Empty: checkout is unavailable.
LAVA_API_KEY=
# Lava sends this in the X-Api-Key header of every webhook (generated by `pnpm env:local`).
LAVA_WEBHOOK_SECRET=
