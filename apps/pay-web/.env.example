PAYMENTS_API_URL=http://localhost:4003
AUTH_API_URL=http://localhost:4001
# Public identity frontend: sign-in goes through its /authorize (SSO client pay-web)
ID_URL=http://localhost:3002
# Public address of this app: SSO callback and the checkout return page
APP_URL=http://localhost:3003
# https origins a checkout may send the buyer to (comma-separated), e.g. https://app.lava.top
# Empty: buying from the catalog stays off
CHECKOUT_ORIGINS=
# x-forwarded-for behind Traefik only; cf-connecting-ip behind the Cloudflare proxy
CLIENT_IP_SOURCE=x-forwarded-for
# Public site with the privacy policy
SITE_URL=http://localhost:3000
