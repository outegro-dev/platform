# Local development against `pnpm infra:up`. Generate .env from the repo root with `pnpm env:local`.
NODE_ENV=development
PORT=4006
# Prometheus /metrics on its own port (0 turns it off); one per service locally.
METRICS_PORT=9466
LOG_LEVEL=debug
DATABASE_URL=postgres://roulette:roulette@localhost:5432/roulette
# Production: a Valkey of its own (ADR-012); locally the shared one, keys under "roulette:".
VALKEY_URL=redis://localhost:6379
AUTH_JWKS_URL=http://localhost:4001/.well-known/jwks.json
AUTH_ISSUER=http://localhost:4001
AUTH_AUDIENCE=outegro
# Browser origins allowed to open /ws (comma-separated): roulette-web.
WS_ALLOWED_ORIGINS=http://localhost:3007
# fair-roll-backend (internal) and the shared service token it checks.
FAIR_ROLL_URL=http://localhost:4100
INTERNAL_API_TOKEN=
# Bets are grumbles (GRM) from wallet-backend's internal API (:4007, same INTERNAL_API_TOKEN).
# "memory" is a stand-in for runs without wallet-backend: one replica, balances reset
# on restart, every new player starts with the opening balance. Production requires http.
WALLET_MODE=memory
WALLET_URL=http://localhost:4007
WALLET_MEMORY_OPENING_BALANCE=1000
# Table limits in grumbles (owner, 28.10.2026).
ROULETTE_MIN_BET=10
ROULETTE_MAX_BET=100000
ROULETTE_BETS_PER_ROUND=3
ROULETTE_PAYOUT_LIMIT_PER_COLOR=1000000
