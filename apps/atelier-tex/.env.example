# atelier-tex: CV rendering with XeLaTeX and poppler. Locally it runs in
# Docker (infra/local/atelier.compose.yaml), which reads ATELIER_TEX_TOKEN
# from this app's .env; `pnpm dev` on the host needs xelatex and poppler.
NODE_ENV=development
PORT=4010
# Prometheus /metrics on its own port (0 turns it off); one per service locally.
METRICS_PORT=9470
LOG_LEVEL=debug
# Bearer token atelier-backend sends; at least 32 characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ATELIER_TEX_TOKEN=
# XeLaTeX compiles at once; renders beyond them wait (up to TEX_QUEUE_MAX).
TEX_CONCURRENCY=2
TEX_QUEUE_MAX=16
# One xelatex run (a render runs it twice) or one poppler call.
TEX_TIMEOUT_MS=60000
# Parent of the per-render temporary folders (default: the OS temp dir).
# TEX_WORK_DIR=
