APP_URL=http://localhost:3007
ROULETTE_API_URL=http://localhost:4006
# Public origin of the game WebSocket (the browser connects to <origin>/ws).
# Production: wss://roulette.outegro.dev (ingress routes /ws to the backend).
GAME_WS_URL=ws://localhost:4006
# The player's own wallet (balance in grumbles) and the bonus of the day.
WALLET_API_URL=http://localhost:4007
DAILY_API_URL=http://localhost:4101
AUTH_API_URL=http://localhost:4001
ID_URL=http://localhost:3002
SITE_URL=http://localhost:3000
# Public payments, Education, Battleship and admin frontends for the account
# links. Production defaults: https://pay.outegro.dev, https://edu.outegro.dev,
# https://battleship.outegro.dev, https://admin.outegro.dev
PAY_URL=http://localhost:3003
EDU_URL=http://localhost:3006
BATTLESHIP_URL=http://localhost:3005
ADMIN_URL=http://localhost:3004
# x-forwarded-for behind Traefik only; cf-connecting-ip behind the Cloudflare proxy
CLIENT_IP_SOURCE=x-forwarded-for
