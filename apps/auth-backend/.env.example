# Local development against `pnpm infra:up`. Generate .env from the repo root with `pnpm env:local`.
NODE_ENV=development
PORT=4001
# Prometheus /metrics on its own port (0 turns it off); one per service locally.
METRICS_PORT=9461
LOG_LEVEL=debug
DATABASE_URL=postgres://auth:auth@localhost:5432/auth
VALKEY_URL=redis://localhost:6379
RABBITMQ_URL=amqp://outegro:outegro@localhost:5672
AUTH_ISSUER=http://localhost:4001
AUTH_AUDIENCE=outegro
NOTIFICATIONS_INTERNAL_URL=http://localhost:4002
JWT_PRIVATE_KEY=
LOGIN_CODE_PEPPER=
INTERNAL_API_TOKEN=
# Platform apps that sign in through id-web (exact redirect URIs, see ID-04).
OAUTH_CLIENTS=[{"id":"pay-web","name":"Payments","redirectUris":["http://localhost:3003/auth/callback"]},{"id":"admin-web","name":"Admin","redirectUris":["http://localhost:3004/auth/callback"]},{"id":"battleship-web","name":"Battleship","redirectUris":["http://localhost:3005/auth/callback"]}]
# Sign-in with Google (ID-02), off unless all three are set. The redirect is
# registered in Google Console for localhost as well.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3002/login/google/callback
# Passkeys (ID-05): the relying party is id-web. Production defaults are
# id.outegro.dev and https://id.outegro.dev; locally id-web is on localhost.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3002
