# Local development against `pnpm infra:up`. Generate .env with `pnpm env:local`.
NODE_ENV=development
PORT=4001
LOG_LEVEL=debug
DATABASE_URL=postgres://auth:auth@localhost:5432/auth
VALKEY_URL=redis://localhost:6379
RABBITMQ_URL=amqp://outegro:outegro@localhost:5672
AUTH_ISSUER=http://localhost:4001
AUTH_AUDIENCE=outegro
NOTIFICATIONS_INTERNAL_URL=http://localhost:4002
JWT_PRIVATE_KEY=
LOGIN_CODE_PEPPER=
INTERNAL_API_TOKEN=
