# llm-gateway: Codex CLI (primary), Claude Code CLI and MiniMax behind one API.
# Copy to .env; Compose (infra/local/atelier.compose.yaml) reads the same file.
NODE_ENV=development
PORT=4009
# Prometheus /metrics on its own port (0 turns it off); one per service locally.
METRICS_PORT=9469
LOG_LEVEL=info
# Bearer token of the callers (atelier workers), at least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LLM_GATEWAY_TOKEN=
# Profiles and provider threads; empty: config/llm-profiles.json of this app.
LLM_PROFILES_PATH=
# Pause after a usage limit whose reset time the provider did not name.
LLM_QUOTA_PAUSE_SECONDS=3600
# Longest wait for a free provider slot before 503 provider_unavailable.
LLM_QUEUE_TIMEOUT_MS=900000
# The one logged-in account a request may name in `account`.
LLM_ACCOUNT=owner
# Codex login and state (codex login --device-auth with this CODEX_HOME).
# Empty: ~/.codex. Compose mounts the login volume at /codex-auth.
CODEX_HOME=
# Claude Code subscription token (claude setup-token). Empty: Claude profiles unavailable.
CLAUDE_CODE_OAUTH_TOKEN=
# MiniMax API key (Anthropic-compatible API). Empty: MiniMax profiles unavailable.
MINIMAX_API_KEY=
