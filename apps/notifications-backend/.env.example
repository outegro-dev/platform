# Local development against `pnpm infra:up`. Generate .env from the repo root with `pnpm env:local`.
NODE_ENV=development
PORT=4002
# Prometheus /metrics on its own port (0 turns it off); one per service locally.
METRICS_PORT=9462
LOG_LEVEL=debug
DATABASE_URL=postgres://notifications:notifications@localhost:5432/notifications
VALKEY_URL=redis://localhost:6379
RABBITMQ_URL=amqp://outegro:outegro@localhost:5672
AUTH_JWKS_URL=http://localhost:4001/.well-known/jwks.json
AUTH_ISSUER=http://localhost:4001
AUTH_AUDIENCE=outegro
EMAIL_PROVIDER=smtp
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Nick Lukashik <no-reply@outegro.dev>
PUBLIC_WEB_URL=http://localhost:3000
ACCOUNT_URL=http://localhost:3002
INTERNAL_API_TOKEN=
# Telegram (optional locally). Linking needs the bot name; the webhook is
# registered at startup only when both URL and secret are set.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_URL=
# TELEGRAM_WEBHOOK_SECRET=
