# Local development against `pnpm infra:up`. Generate .env from the repo root with `pnpm env:local`.
NODE_ENV=development
PORT=4007
# Prometheus /metrics on its own port (0 turns it off); one per service locally.
METRICS_PORT=9467
LOG_LEVEL=debug
DATABASE_URL=postgres://wallet:wallet@localhost:5432/wallet
VALKEY_URL=redis://localhost:6379
RABBITMQ_URL=amqp://outegro:outegro@localhost:5672
AUTH_JWKS_URL=http://localhost:4001/.well-known/jwks.json
AUTH_ISSUER=http://localhost:4001
AUTH_AUDIENCE=outegro
# The platform's shared service token: payments and roulette-backend call the
# internal API with it (generated by `pnpm env:local`, same in every service).
INTERNAL_API_TOKEN=
# The most one admin command may grant or take.
WALLET_ADMIN_MAX_AMOUNT=1000000
# Reconciliation: a sample pass every 5 minutes, a full one daily after 02:00 UTC.
RECONCILE_INTERVAL_MS=300000
RECONCILE_FULL_HOUR_UTC=2
RECONCILE_SAMPLE_SIZE=100
